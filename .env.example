# ─────────────────────────────────────────────────────────────────────────────
# LiteLLM Tray Connector — reconfiguration template
#
# Copy this file to ".env" and fill in the values for the customer you're
# deploying to:   cp .env.example .env
#
# ".env" is gitignored — your real token/key stay on your machine.
#
# NOTE on what is auto-consumed vs. reference:
#   • TRAY_API_TOKEN is read by the tray-cdk CLI (export it / source this file
#     before `tray-cdk deployment create` and `permissions add`; it's also
#     auto-loaded from .env by `tray-cdk connector oauth2-token`).
#   • The remaining values are NOT read automatically by tray-cdk — they are
#     the reference values you paste into connector.json / the Tray Service /
#     the auth screen. Keeping them here means one place to reconfigure.
#
# Load everything into your shell for a deploy:
#   export $(grep -v '^#' .env | grep -v '^$' | xargs)
# ─────────────────────────────────────────────────────────────────────────────

# A Tray API token from the Tray app, scoped to the org/region below.
# Used by: tray-cdk deployment create / permissions add / oauth2-token.
TRAY_API_TOKEN=your-tray-api-token-here

# Tray API base URL for your region (US default). EU: https://api.eu1.tray.io
# (the --us | --eu | --ap | --ap2 flag on tray-cdk commands also selects region)
TRAY_API_BASE_URL=https://api.tray.io

# Your Tray organization id. Used by: tray-cdk namespace get/create <org-id>.
TRAY_ORG_ID=00000000-0000-0000-0000-000000000000

# Your org's connector namespace. The "name" in connector.json MUST be
# "<CDK_NAMESPACE>-litellm" (e.g. springhealth -> springhealth-litellm).
# Find/create it: tray-cdk namespace get <TRAY_ORG_ID> --us
CDK_NAMESPACE=your-namespace

# The Unique Service Name Tray generates when you create the Token Service
# (with user fields `endpoint` + `api_key`). Paste this into
# connector.json -> service.name.
service_name=XXXXXXXXXXXXXXX_litellm-auth-template

# ── LiteLLM proxy auth (the values entered on the New-authentication screen,
#    and what you put in src/test.ctx.json to run `npm test`) ──
# Proxy base URL — no trailing slash, no /v1. Must be reachable from Tray Cloud.
endpoint=https://litellm.your-domain.com
# A LiteLLM key (virtual or master); sent as Authorization: Bearer <key>.
api_key=your-litellm-key-here
