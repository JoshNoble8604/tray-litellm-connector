{
  "//": "LM Studio → right-click the 🔌 icon or edit mcp.json (Program tab). Replace both absolute paths with yours.",
  "mcpServers": {
    "game-dev-assistant": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/tray-litellm-connector/game-dev-assistant/dist/server.js",
        "--project=/ABSOLUTE/PATH/TO/YourUnityOrUnrealProject",
        "--engine=unity"
      ],
      "env": {
        "LMSTUDIO_BASE_URL": "http://localhost:1234/v1"
      }
    }
  }
}
